<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key><string>tr</string>
	<key>CFBundleDisplayName</key><string>HizmetCep</string>
	<key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
	<key>CFBundleName</key><string>hizmetcep</string>
	<key>CFBundlePackageType</key><string>APPL</string>
	<key>CFBundleShortVersionString</key><string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleVersion</key><string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key><true/>
	<key>UILaunchStoryboardName</key><string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key><string>Main</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>İlan ve profil fotoğrafı eklemek için galeriye erişim gerekir.</string>
	<key>NSCameraUsageDescription</key>
	<string>İlan ve profil fotoğrafı çekmek için kameraya erişim gerekir.</string>
	<!-- image_picker: seçilen fotoğrafın düzenlenmiş halini kaydetme -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Düzenlenen fotoğrafı galerinize kaydetmek için izin gerekir.</string>
	<!-- flutter_secure_storage: Keychain erişimi biyometri ile korunabilir -->
	<key>NSFaceIDUsageDescription</key>
	<string>Oturum bilgilerinizi güvenle saklamak için Face ID kullanılır.</string>
	<!-- connectivity_plus: yerel ağ durumu okuma (iOS 14+) -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Bağlantı durumunu denetlemek için yerel ağ bilgisi kullanılır.</string>
	<key>UISupportedInterfaceOrientations</key>
	<array><string>UIInterfaceOrientationPortrait</string></array>
	<!-- ÖDEME DÖNÜŞÜ: hizmetcep://payment/return
	     Sağlayıcı ödeme sayfasından uygulamaya dönüş için gereklidir. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.hizmetcep.app.payment</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>hizmetcep</string>
			</array>
		</dict>
		<!-- GOOGLE İLE GİRİŞ (google_sign_in)
		     Aşağıdaki değer GoogleService-Info.plist içindeki
		     REVERSED_CLIENT_ID ile DEĞİŞTİRİLMELİDİR.
		     Örnek: com.googleusercontent.apps.1234567890-abcdef
		     ⚠ DIŞ SERVİS: Google Cloud Console'dan alınır. -->
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.hizmetcep.app.google</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>REVERSED_CLIENT_ID_BURAYA</string>
			</array>
		</dict>
	</array>
	<!-- Harici uygulama açma izinleri: mağaza ve ödeme sayfası. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>https</string>
		<string>itms-apps</string>
	</array>
</dict>
</plist>
