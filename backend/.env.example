# ═══════════════════════════════════════════════════════════════
# HizmetCep backend — ÖRNEK ortam değişkenleri (GERÇEK DEĞER YOK)
#
# ⚠ Bu dosya yalnız ADLARI ve BİÇİMLERİ gösterir. Gerçek değerler Render
#   panelinde (Environment / Secret Files) girilir; Git'e, ZIP'e, Flutter'a
#   ve günlüğe GİRMEZ. Yerelde kopyalayıp `.env` yapabilirsiniz (.gitignore'da).
# ⚠ <...> ile gösterilen yerleri kendi değerlerinizle doldurun; boş
#   bırakılanlar isteğe bağlıdır. Ayrıntı: DEPLOY.md → "Render kurulumu".
# ═══════════════════════════════════════════════════════════════

# ── Çalışma ortamı ──────────────────────────────────────────────
NODE_ENV=production
# Render PORT'u kendisi verir; elle girmeyin.
# PORT=8080

# ── Veritabanı (ÜRETİMDE ZORUNLU) ───────────────────────────────
HC_DB_DRIVER=postgres
HC_DATABASE_URL=postgres://<kullanici>:<parola>@<host>:5432/<veritabani>
# TLS üretimde kapatılamaz (HC_DB_SSL=false üretimde reddedilir).
# HC_DB_SSL=true
# Yönetilen PostgreSQL özel CA kullanıyorsa PEM içeriği:
# HC_DB_CA_PEM=
# Örnek başına havuz boyutu (DEPLOY.md → bağlantı bütçesi):
# HC_DB_POOL=10

# ── Sırlar (ÜRETİMDE ZORUNLU; BÜTÜN örneklerde AYNI) ────────────
# openssl rand -base64 32
HC_MASTER_KEY=<32 bayt base64>
# en az 32 karakter rastgele: openssl rand -base64 48
HC_JWT_SECRET=<en az 32 karakter>

# ── Firebase ────────────────────────────────────────────────────
HC_FIREBASE_PROJECT_ID=hizmetcep-fe036
# AÇIK web API anahtarı (gizli değil; Google Cloud'da kısıtlanmalı):
# HC_FIREBASE_WEB_API_KEY=

# ── FCM servis hesabı (ÜRETİMDE ZORUNLU — YALNIZ BİRİ) ──────────
# A) Render Secret File (ÖNERİLEN): dosyayı Secret Files'a ekleyin, yolunu verin.
HC_FCM_SERVICE_ACCOUNT_FILE=/etc/secrets/<dosya-adi>.json
# B) Ortam değeri: servis hesabı JSON'unun tamamı (düz ya da base64).
# HC_FCM_SERVICE_ACCOUNT=
# İkisi birden verilirse sunucu açılmaz. project_id, HC_FIREBASE_PROJECT_ID ile aynı olmalı.

# ── SMS / E-posta sağlayıcısı ───────────────────────────────────
# Seçenekler: webhook (gerçek sağlayıcıya HTTPS köprü) · TANIMSIZ (yalnız admin
# panelindeki etkin entegrasyon) · log (YALNIZ geliştirme; üretimde reddedilir).
# Sağlayıcı yoksa SAHTE değer girmeyin: tanımsız bırakın; gönderimler FAILED
# kaydedilir, sunucu OTP isteği 503 döner.
# HC_SMS_PROVIDER=webhook
# HC_SMS_WEBHOOK_URL=https://<sms-kopru-adresi>
# HC_SMS_WEBHOOK_TOKEN=<sağlayıcı Bearer anahtarı>
# HC_EMAIL_PROVIDER=webhook
# HC_EMAIL_WEBHOOK_URL=https://<eposta-kopru-adresi>
# HC_EMAIL_WEBHOOK_TOKEN=<sağlayıcı Bearer anahtarı>

# ── Nesne depolama (S3 uyumlu; dördü birlikte ya da admin entegrasyonu) ──
# HC_S3_ENDPOINT=https://<hesap>.r2.cloudflarestorage.com
# HC_S3_BUCKET=<kova>
# HC_S3_ACCESS_KEY_ID=<erişim anahtarı>
# HC_S3_SECRET_ACCESS_KEY=<gizli anahtar>
# HC_S3_REGION=auto
# HC_S3_PATH_STYLE=false

# ── Web / ağ ────────────────────────────────────────────────────
# Kullanıcı API'sine tarayıcıdan erişebilecek kökenler (virgülle, https, joker yok).
HC_CORS_ORIGINS=https://hizmetcep.com
# Güvenilen proxy'nin X-Forwarded-For SAĞINA eklediği değer sayısı (0–5).
# TAHMİNLE VERİLMEZ: DEPLOY.md'deki ölçüm adımıyla belirlenir. Tanımsız = 0.
# HC_TRUST_PROXY_HOPS=

# ── İsteğe bağlı ────────────────────────────────────────────────
# Eşzamanlı push çalıştırıcısı (1–32):
# HC_PUSH_PARALEL=1

# ── ÜRETİMDE TANIMLANAMAZ (tanımlıysa sunucu açılmaz) ──────────
# HC_TEST_OTP_KANCASI, HC_INTEGRATION_ALLOW_PRIVATE, HC_TRUST_PROXY (eski)
