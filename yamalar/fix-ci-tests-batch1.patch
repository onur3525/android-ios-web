+  /auth/firebase/session:
+    post:
+      tags: [Auth]
+      summary: Firebase ID token ile HizmetCep oturumu
+      description: |
+        Firebase Authentication ile giriş yapan istemci, aldığı ID token'ı
+        gönderir; sunucu token'ı Google'ın açık sertifikalarıyla doğrular,
+        doğrulanmış telefon/e-postayla hesabı eşleştirir ve HizmetCep
+        oturumu açar. Hesap yoksa 404; askı/ban/dondurma kuralları aynen.
+      responses:
+        '200': { description: Başarılı }
+        '400': { $ref: '#/components/responses/BadRequest' }
+        '401': { $ref: '#/components/responses/Unauthorized' }
+        '404': { description: Eşleşen hesap yok }
+
   /auth/otp/request:
     post:
       tags: [Auth]
