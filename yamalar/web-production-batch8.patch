diff -ruN a/.github/workflows/web-production.yml b/.github/workflows/web-production.yml
--- a/.github/workflows/web-production.yml	1970-01-01 00:00:00.000000000 +0000
+++ b/.github/workflows/web-production.yml	2026-10-07 05:45:01.278057586 +0000
@@ -0,0 +1,97 @@
+# ═══════════════════════════════════════════════════════════════
+# HizmetCep — PRODUCTION WEB DERLEMESİ (https://hizmetcep.com)
+#
+# ⚠ GITHUB PAGES İLE KARIŞTIRILMAZ:
+#   · GitHub Pages (https://onur3525.github.io/android-ios-web/) TEST/DEMO
+#     yayınıdır; debug + mock, base-href /android-ios-web/. Bu iş akışı ona
+#     DOKUNMAZ ve onun base-href'ini KULLANMAZ.
+#   · Production kökten çalışır: base-href "/".
+#
+# ⚠ YALNIZ ELLE TETİKLENİR (workflow_dispatch). Push/PR ile ÇALIŞMAZ ve
+#   HİÇBİR YERE YAYIN YAPMAZ: çıktı yalnız bir derleme ürünü (artifact)
+#   olarak saklanır. Barındırmaya (hosting) yükleme ayrı ve bilinçli bir
+#   adımdır.
+#
+# RELEASE GÜVENCELERİ (kodda zaten zorlanıyor, burada ek denetim):
+#   · kReleaseMode → veri kaynağı her zaman gerçek API (mock imkânsız),
+#     test modu/test OTP kapalı (lib/core/test_modu.dart), teşhis bayrakları
+#     kapalı (lib/core/teshis.dart).
+#   · API_BASE_URL https zorunlu, WebSocket wss zorunlu (api_config.dart).
+#   · STORAGE_HOSTS boşsa release'te yükleme adresleri REDDEDİLİR
+#     (yukleme_adresi.dart) — bu yüzden değişken zorunlu tutulur.
+#   · CERT_PINS web'de KULLANILMAZ (tarayıcı TLS'i kendisi doğrular;
+#     sabitleme yalnız mobil — sabitlemeli_istemci köprüsü).
+#
+# GEREKEN DEPO DEĞİŞKENİ (Settings → Secrets and variables → Actions →
+# Variables):
+#   · HC_STORAGE_HOSTS — üretim depolama alan adı(ları), virgülle.
+#     Örnek biçim: ".r2.cloudflarestorage.com" ya da "medya.hizmetcep.com".
+#     GERÇEK DEĞER HENÜZ YOK — tanımlanmadan bu iş akışı BİLEREK durur.
+# ═══════════════════════════════════════════════════════════════
+name: web-production
+on:
+  workflow_dispatch:
+permissions:
+  contents: read
+concurrency:
+  group: web-production
+  cancel-in-progress: false
+env:
+  # Karar (6 Eki): production API.
+  API_BASE_URL: https://api.hizmetcep.com/api/v1
+jobs:
+  web-release:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+
+      - name: Zorunlu değerler tanımlı mı
+        env:
+          STORAGE_HOSTS: ${{ vars.HC_STORAGE_HOSTS }}
+        run: |
+          set -eu
+          if [ -z "${STORAGE_HOSTS}" ]; then
+            echo "::error::HC_STORAGE_HOSTS depo değişkeni tanımlı değil (üretim depolama alan adı). Değer uydurulmaz."
+            exit 1
+          fi
+          case "$API_BASE_URL" in
+            https://*) ;;
+            *) echo "::error::API_BASE_URL https olmalı"; exit 1 ;;
+          esac
+
+      - uses: subosito/flutter-action@v2
+        with:
+          channel: stable
+          cache: true
+      - run: flutter --version
+      - run: flutter pub get
+
+      - name: Production web derlemesi (release, kök base-href)
+        env:
+          STORAGE_HOSTS: ${{ vars.HC_STORAGE_HOSTS }}
+        run: |
+          flutter build web --release \
+            --base-href / \
+            --dart-define=API_BASE_URL="$API_BASE_URL" \
+            --dart-define=STORAGE_HOSTS="$STORAGE_HOSTS" \
+            --dart-define=APP_ENV=production
+
+      - name: Çıktı denetimi (test/demo sızıntısı yok)
+        run: |
+          set -eu
+          cd build/web
+          grep -q '<base href="/">' index.html || { echo "::error::base-href kök (/) değil"; exit 1; }
+          grep -q 'api.hizmetcep.com' main.dart.js || { echo "::error::production API adresi derlemede yok"; exit 1; }
+          if grep -q 'onur3525.github.io/android-ios-web' main.dart.js index.html; then
+            echo "::error::GitHub Pages test adresi production derlemesine girmiş"; exit 1
+          fi
+          if grep -q 'android-ios-web' index.html; then
+            echo "::error::GitHub Pages base-href production'a taşınmış"; exit 1
+          fi
+          ls -la firebase-messaging-sw.js fcm_web.js fcm_yapilandirma.js
+
+      - uses: actions/upload-artifact@v4
+        with:
+          name: hizmetcep-web-production
+          path: build/web
+          retention-days: 14
