+// ── EK ÜRETİM DENETİMLERİ (yanlış/yarım değer sessizce yanlış davranmasın) ──
+// S3: değişkenlerden biri bile verildiyse dördü de zorunlu; aksi hâlde
+// depolama sessizce "yapılandırılmamış" sayılırdı. Üretimde uç https.
+function depolamaDenetimi() {
+  const adlar = ['HC_S3_ENDPOINT', 'HC_S3_BUCKET', 'HC_S3_ACCESS_KEY_ID', 'HC_S3_SECRET_ACCESS_KEY'];
+  const verilen = adlar.filter((a) => (env[a] || '').trim());
+  if (verilen.length && verilen.length !== adlar.length) {
+    throw new Error(`Depolama yapılandırması yarım: ${adlar.filter((a) => !verilen.includes(a)).join(', ')} eksik.`);
+  }
+  if (verilen.length) {
+    let u;
+    try { u = new URL(env.HC_S3_ENDPOINT); } catch { throw new Error('HC_S3_ENDPOINT geçerli bir adres değil.'); }
+    if (uretim && u.protocol !== 'https:') throw new Error('Üretimde HC_S3_ENDPOINT https olmalıdır.');
+  }
+  if (env.HC_S3_PATH_STYLE && !['true', 'false'].includes(env.HC_S3_PATH_STYLE)) {
+    throw new Error('HC_S3_PATH_STYLE true ya da false olmalıdır.');
+  }
+}
+
+// FCM servis hesabı: verildiyse açılışta doğrulanır (bozuk değer push'u
+// sessizce kapatmasın). İçerik günlüğe YAZILMAZ.
+function fcmDenetimi() {
+  const ham = (env.HC_FCM_SERVICE_ACCOUNT || '').trim();
+  if (!ham) return false;
+  let j;
+  try { j = JSON.parse(ham.startsWith('{') ? ham : Buffer.from(ham, 'base64').toString('utf8')); } catch {
+    throw new Error('HC_FCM_SERVICE_ACCOUNT geçerli bir servis hesabı JSON değeri (düz ya da base64) değil.');
+  }
+  for (const k of ['project_id', 'client_email', 'private_key']) {
+    if (!j[k]) throw new Error(`HC_FCM_SERVICE_ACCOUNT içinde ${k} eksik.`);
+  }
+  if (!String(j.private_key).includes('PRIVATE KEY')) throw new Error('HC_FCM_SERVICE_ACCOUNT private_key PEM biçiminde değil.');
+  return true;
+}
+
+// Yalnız test kancaları üretimde KESİNLİKLE kapalı (kod zaten yok sayıyor;
+// yanlışlıkla tanımlanmışsa açıkça reddedilir).
+if (uretim && env.HC_TEST_OTP_KANCASI) throw new Error('Üretimde HC_TEST_OTP_KANCASI tanımlanamaz.');
+depolamaDenetimi();
+
 export const config = {
+  fcmEtkin: fcmDenetimi(),
   port: Number(env.PORT || 8080),
   jwtSirri: jwtSirri(),
   erisimSuresi: 15 * 60 * 1000, // erişim token'ı 15 dk
diff -ruN a/backend/test/yapilandirma.test.js b/backend/test/yapilandirma.test.js
--- a/backend/test/yapilandirma.test.js	1970-01-01 00:00:00.000000000 +0000
+++ b/backend/test/yapilandirma.test.js	2026-10-07 13:23:19.693964800 +0000
@@ -0,0 +1,52 @@
+// Üretim yapılandırma denetimi: eksik/yanlış değer açılışta açıkça reddedilir.
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { spawnSync } from 'node:child_process';
+import { generateKeyPairSync } from 'node:crypto';
+
+const URETIM = {
+  NODE_ENV: 'production', HC_DB_DRIVER: 'postgres', HC_DATABASE_URL: 'postgres://k:p@db.example/hc?sslmode=require',
+  HC_JWT_SECRET: 'x'.repeat(40), HC_MASTER_KEY: Buffer.alloc(32, 7).toString('base64'),
+  HC_SMS_PROVIDER: 'webhook', HC_SMS_WEBHOOK_URL: 'https://sms.example/x', HC_SMS_WEBHOOK_TOKEN: 't',
+  HC_EMAIL_PROVIDER: 'webhook', HC_EMAIL_WEBHOOK_URL: 'https://mail.example/x', HC_EMAIL_WEBHOOK_TOKEN: 't',
+};
+function ac(ek) {
+  const r = spawnSync(process.execPath, ['--input-type=module', '-e', "await import('./src/config.js'); console.log('ACILDI')"],
+    { cwd: new URL('..', import.meta.url).pathname, env: { PATH: process.env.PATH, ...URETIM, ...ek }, encoding: 'utf8' });
+  return (r.stdout + r.stderr);
+}
+
+test('tam üretim yapılandırması açılır', () => { assert.match(ac({}), /ACILDI/); });
+
+test('kritik eksikler açıkça reddedilir', () => {
+  assert.match(ac({ HC_DATABASE_URL: '' }), /HC_DATABASE_URL zorunludur/);
+  assert.match(ac({ HC_JWT_SECRET: '' }), /HC_JWT_SECRET zorunludur/);
+  assert.match(ac({ HC_JWT_SECRET: 'kisa' }), /en az 32/);
+  assert.match(ac({ HC_MASTER_KEY: '' }), /HC_MASTER_KEY zorunludur/);
+  assert.match(ac({ HC_DB_DRIVER: 'sqlite' }), /yalnız PostgreSQL/);
+  assert.match(ac({ HC_SMS_PROVIDER: 'log' }), /log kullanılamaz/);
+  assert.match(ac({ HC_TEST_OTP_KANCASI: '1' }), /HC_TEST_OTP_KANCASI/);
+});
+
+test('CORS: joker, yol ve http üretimde reddedilir', () => {
+  assert.match(ac({ HC_CORS_ORIGINS: '*' }), /joker/);
+  assert.match(ac({ HC_CORS_ORIGINS: 'https://hizmetcep.com/' }), /yalnız köken/);
+  assert.match(ac({ HC_CORS_ORIGINS: 'http://hizmetcep.com' }), /https olmalı/);
+});
+
+test('depolama: yarım ya da http yapılandırma reddedilir', () => {
+  assert.match(ac({ HC_S3_ENDPOINT: 'https://s3.example', HC_S3_BUCKET: 'b' }), /yarım: HC_S3_ACCESS_KEY_ID, HC_S3_SECRET_ACCESS_KEY eksik/);
+  assert.match(ac({ HC_S3_ENDPOINT: 'http://s3.example', HC_S3_BUCKET: 'b', HC_S3_ACCESS_KEY_ID: 'a', HC_S3_SECRET_ACCESS_KEY: 's' }), /https olmalıdır/);
+  assert.match(ac({ HC_S3_PATH_STYLE: 'evet' }), /true ya da false/);
+  assert.match(ac({ HC_S3_ENDPOINT: 'https://s3.example', HC_S3_BUCKET: 'b', HC_S3_ACCESS_KEY_ID: 'a', HC_S3_SECRET_ACCESS_KEY: 's' }), /ACILDI/);
+});
+
+test('FCM servis hesabı: bozuk değer reddedilir, geçerli değer kabul edilir, içerik yazdırılmaz', () => {
+  assert.match(ac({ HC_FCM_SERVICE_ACCOUNT: '{bozuk' }), /servis hesabı JSON/);
+  assert.match(ac({ HC_FCM_SERVICE_ACCOUNT: JSON.stringify({ project_id: 'p' }) }), /client_email eksik/);
+  const pem = generateKeyPairSync('rsa', { modulusLength: 1024 }).privateKey.export({ type: 'pkcs8', format: 'pem' });
+  const iyi = JSON.stringify({ project_id: 'p', client_email: 'x@p.iam.gserviceaccount.com', private_key: pem });
+  const cikti = ac({ HC_FCM_SERVICE_ACCOUNT: Buffer.from(iyi).toString('base64') });
+  assert.match(cikti, /ACILDI/);
+  assert.doesNotMatch(cikti, /PRIVATE KEY/);
+});
